# =============================================================================
# MLOps Platform — Environment Variables
# .env is committed with demo defaults — copy and adjust for your environment
# Machine-specific overrides go in .env.local (gitignored)
# =============================================================================

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mlops
POSTGRES_USER=mlops_user
POSTGRES_PASSWORD=changeme_secure_password

# Superuser (used only by init scripts)
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=changeme_superuser_password

# ---------------------------------------------------------------------------
# MLflow
# ---------------------------------------------------------------------------
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_ARTIFACT_ROOT=/mlflow-artifacts
# MLflow uses the mlflow schema inside the mlops database
MLFLOW_BACKEND_STORE_URI=postgresql+psycopg2://mlops_user:changeme_secure_password@postgres:5432/mlops?options=-csearch_path%3Dmlflow

# ---------------------------------------------------------------------------
# Airflow
# ---------------------------------------------------------------------------
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://mlops_user:changeme_secure_password@postgres:5432/mlops
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=your_fernet_key_here
AIRFLOW__WEBSERVER__SECRET_KEY=your_webserver_secret_key_here
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com

# ---------------------------------------------------------------------------
# Flask Model Serving API
# ---------------------------------------------------------------------------
FLASK_PORT=5001
MODEL_REGISTRY_NAME=credit-risk-classifier
MODEL_ALIAS=production
DECISION_THRESHOLD=0.5

# ---------------------------------------------------------------------------
# Monitoring Thresholds
# Retraining triggers when: ROC-AUC < MIN_ROC_AUC  OR  drift_score > MAX_DRIFT_SCORE
# ---------------------------------------------------------------------------
MIN_ROC_AUC=0.60
MAX_DRIFT_SCORE=0.20
MAX_DRIFT_FEATURE_FRACTION=0.30

# ---------------------------------------------------------------------------
# Challenger Comparison (DAG 06)
# CHALLENGER_CV_FOLDS   — number of StratifiedKFold folds (default 5)
# CHALLENGER_CV_MARGIN  — challenger must beat production by at least this
#                         amount (absolute, on the primary metric) to be
#                         promoted. Default 0.05 = 5 percentage points.
# ---------------------------------------------------------------------------
CHALLENGER_CV_FOLDS=5
CHALLENGER_CV_MARGIN=0.05
DEFAULT_PRIMARY_METRIC=roc_auc

# ---------------------------------------------------------------------------
# Training Runtime
# Airflow retraining defaults to conservative single-process execution to avoid
# joblib multiprocessing issues inside the scheduler container.
# ---------------------------------------------------------------------------
TRAINING_SEARCH_N_JOBS=1
TRAINING_MODEL_N_JOBS=1
XGBOOST_N_JOBS=1
RF_N_JOBS=1
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1
JOBLIB_TEMP_FOLDER=/tmp
GIT_PYTHON_REFRESH=quiet
